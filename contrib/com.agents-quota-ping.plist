<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agents-quota-ping</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/quota-ping</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>2</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>17</integer>
      <key>Minute</key><integer>4</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/agents-quota-ping/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/agents-quota-ping/launchd.log</string>
</dict>
</plist>
